# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
.svn/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# SVN이 따로 관리하는 에셋 폴더 (각각 별도 작업본 = 자체 .svn 보유).
# git에는 넣지 않는다. 용량이 크고 두 VCS가 같은 파일을 다투면 충돌이 난다.
/Assets/3.Resources
/Assets/3.Resources.meta
/Assets/4.ThirdParty
/Assets/4.ThirdParty.meta
# 일회성 원본 .meta 백업은 Git 머지 대상에서 제외한다.
/_MetaBackup_original/
# RealToon은 SVN의 "5. Projects/RealToon" 전용 라인에서 관리한다(r151~).
# 회사 권장 위치 기준으로 원본 무수정 에셋을 Assets/RealToon에 그대로 받는다.
# 옮기면 안 된다: 셰이더 GUI가 "Assets/RealToon/..." 절대경로를 하드코딩하고,
# 아웃라인 등 옵션을 .shader 소스 직접 재작성으로 구현해서 조용히 무동작한다.
/Assets/RealToon
/Assets/RealToon.meta
Packages/com.youngwoocho02.unity-cli-connector/
Packages/unity-cli/
/Tools

# Local agent bootstrap files
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/.claude/

# Syncthing sync metadata
.stfolder/
/Assets/ProgrammerResource