%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ce9103e12465a14d85590d76f360068, type: 3}
  m_Name: NpcSpeechTable
  m_EditorClassIdentifier: Assembly-CSharp::NpcSpeechTableSO
  m_lines:
  - NpcId: Manufacturing
    MinClearCount: 0
    Line: "\uD544\uC694\uD55C \uC81C\uC791 \uC544\uC774\uD15C\uC740 \uB4E0\uB4E0\uD788
      \uCC59\uACA8 \uAC00.\n\uC900\uBE44\uAC00 \uB05D\uB098\uBA74 \uC815\uBB38 \uC55E
      \uACBD\uBE44 \uB2F4\uB2F9\uC790\uC5D0\uAC8C \uAC00\uBA74 \uB3FC."
  - NpcId: Manufacturing
    MinClearCount: 0
    Line: "\uD68C\uC0C9 \uC548\uAC1C\uAC00 \uD589\uC6B4\uC744 \uAC00\uC838\uB2E4\uC8FC\uAE38\u2026"
  - NpcId: Manufacturing
    MinClearCount: 1
    Line: "\uBAA8\uC544 \uC628 \uC7AC\uB8CC\uB85C \uC81C\uC791 \uC544\uC774\uD15C\uC744
      \uAD6C\uB9E4\uD558\uAC70\uB098\n\uC81C\uC870\uC2E4\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC\uD560
      \uC218 \uC788\uC5B4."
  - NpcId: Manufacturing
    MinClearCount: 1
    Line: "\uAC15\uD654 \uC778\uAC04\uC774\uB77C\uB3C4 \uC900\uBE44\uAC00 \uD5C8\uC220\uD558\uBA74
      \uC704\uD5D8\uD560 \uAC70\uC57C."
  - NpcId: Medical
    MinClearCount: 0
    Line: "\uC5B4\uB514 \uBD88\uD3B8\uD55C \uACF3\uC774 \uC788\uB294 \uAC70\uC57C?\n\uAC15\uD654
      \uC778\uAC04\uC774\uB77C\uB3C4 \uC804\uD22C\uAC00 \uB05D\uB098\uBA74 \uBAB8
      \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uB294 \uAC78 \uC78A\uC9C0 \uB9C8."
  - NpcId: Medical
    MinClearCount: 1
    Line: "\uB3CC\uC544\uC654\uAD6C\uB098. \uC5B4\uB514 \uBD88\uD3B8\uD55C \uACF3\uC740
      \uC5C6\uC5B4?"
  - NpcId: Medical
    MinClearCount: 1
    Line: "\uB2E4\uC74C \uC804\uD22C \uC804\uC5D0 \uB300\uC6D0\uB4E4 \uBAB8 \uC0C1\uD0DC\uB3C4
      \uD655\uC778\uD574 \uC918.\n\uCE58\uB8CC\uAC00 \uD544\uC694\uD558\uBA74 \uB0B4\uAC00
      \uB3CC\uBCFC\uAC8C."
  - NpcId: Scramble
    MinClearCount: 0
    Line: "\uAE5C\uBC15\uD55C \uAC74 \uC5C6\uC9C0?\n\uBB38\uBC16\uC5D0\uC120 \uB0B4\uAC00
      \uB300\uC2E0 \uCC59\uACA8 \uC904 \uC218 \uC5C6\uAC70\uB4E0."
  - NpcId: Scramble
    MinClearCount: 0
    Line: "\uC900\uBE44\uB410\uC73C\uBA74 \uB098\uD55C\uD14C \uB9D0\uD574. \uCD9C\uACA9\uC744
      \uB3C4\uC640\uC904\uAC8C."
  - NpcId: Scramble
    MinClearCount: 1
    Line: "\uC810\uAC80\uC740 \uB05D\uB0AC\uC5B4?"
  - NpcId: Scramble
    MinClearCount: 1
    Line: "\uC9C0\uB09C \uC804\uD22C\uC5D0\uC11C \uC5BB\uC740 \uC790\uC6D0\uC73C\uB85C\n\uC804\uD22C
      \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C \uB9C8\uCCE4\uB2E4\uBA74 \uCD9C\uACA9\uD574\uB3C4
      \uC88B\uC544."
  - NpcId: NPC02
    MinClearCount: 0
    Line: "\uC774\uBC88\uC5D0\uB3C4 \uC6B0\uB9AC\uAC00 \uC774\uACA8 \uB0BC \uAC70\uC57C!\n\uC774\uACF3\uC740
      \uC9D9\uC740 \uD68C\uC0C9 \uC548\uAC1C \uC9C0\uB300\uB77C\n\uBCC0\uC774\uCCB4\uC758
      \uC2DC\uC57C\uB97C \uAC00\uB824 \uC904 \uD14C\uB2C8\uAE4C."
  - NpcId: NPC02
    MinClearCount: 1
    Line: "\uB2E4\uB978 \uACF3\uB3C4 \uBCC4\uC77C \uC5C6\uACA0\uC9C0?\n\uC870\uAE08
      \uB354 \uB458\uB7EC\uBD10\uC57C\uACA0\uC5B4."
  - NpcId: NPC03
    MinClearCount: 0
    Line: "\uC5EC\uAE34 \uC6B0\uB9AC\uC758 \uB9C8\uC9C0\uB9C9 \uD130\uC804\uC774\uC57C.\n\uB098\uB3C4
      \uB108\uD76C\uCC98\uB7FC \uC9C1\uC811 \uB098\uC11C\uC11C\n\uC9C0\uD0AC \uC218
      \uC788\uC73C\uBA74 \uC88B\uC744 \uD150\uB370\u2026"
  - NpcId: NPC03
    MinClearCount: 1
    Line: "\uC804\uD22C \uC5C5\uADF8\uB808\uC774\uB4DC\uD574\uC11C \uC9C0\uC815 \uC0AC\uC218\uB85C
      \uBC30\uCE58\uD574 \uC918.\n\uC774\uBC88\uC5D4 \uC6B0\uB9AC\uB3C4 \uC5C4\uD638
      \uC0AC\uACA9\uC73C\uB85C \uD798\uC744 \uBCF4\uD0DC\uACE0 \uC2F6\uC5B4!"
